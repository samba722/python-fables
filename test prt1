#--- Etape 1 : Découpage

import re
from typing import Dict, List

def extraire_fables(chemin_fichier: str) -> List[Dict[str, any]]:
    with open(chemin_fichier, "r", encoding="utf-8") as f:
     contenu = f.read()

    debut_marqueur = "*** START OF THE PROJECT GUTENBERG EBOOK"
    fin_marqueur = "*** END OF THE PROJECT GUTENBERG EBOOK"

    pos_debut = contenu.find(debut_marqueur)
    if pos_debut != -1:
      contenu = contenu[contenu.find("\n", pos_debut) + 1 :]

    pos_fin = contenu.find(fin_marqueur)
    if pos_fin != -1:
      contenu = contenu[:pos_fin]

    # Ignorer la préface avant le Livre Premier
    pos_livre1 = contenu.find("LIVRE PREMIER")
    if pos_livre1 != -1:
      contenu = contenu[pos_livre1:]

    fables: List[Dict[str, any]] = []
    morceaux = contenu.split("\n\n")

    id_fable = 1
    titre_actuel = ""
    texte_actuel = []

    for morceau in morceaux:
        ligne = morceau.strip()
        if not ligne:
            continue

        # Ignorer les titres de séparation des livres (ex: LIVRE DEUXIÈME)
        if re.match(r"^LIVRE\s+", ligne, re.IGNORECASE):
            continue

        # Détecter uniquement les vrais titres de fables (ex: Fable I., FABLE PREMIÈRE...)
        if len(ligne) < 60 and re.match(r"^Fable\s+", ligne, re.IGNORECASE):
            if titre_actuel and texte_actuel:
                fables.append(
                    {
                        "id": id_fable,
                        "titre": titre_actuel,
                        "texte": " ".join(texte_actuel),
                    }
                )
                id_fable += 1
                texte_actuel = []
            titre_actuel = ligne
        elif titre_actuel:
            texte_actuel.append(ligne)

    if titre_actuel and texte_actuel:
        fables.append(
            {"id": id_fable, "titre": titre_actuel, "texte": " ".join(texte_actuel)}
        )

    return fables


if __name__ == "__main__":
    liste = extraire_fables("fable.txt")
    print(f"Fables extraites : {len(liste)}")
    if liste:
        print(liste[0])